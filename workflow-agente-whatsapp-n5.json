    {
      "parameters": {
        "toolDescription": "Verifica si el sitio web del cliente responde. Devuelve el código de estado HTTP (200 = funciona).",
        "url": "={{ $('Code - Buscar proyecto').first().json.sitio }}",
        "options": {
          "response": {
            "response": {
