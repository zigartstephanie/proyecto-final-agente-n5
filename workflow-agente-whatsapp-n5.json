    {
      "parameters": {
        "jsCode": "// Busca el proyecto del remitente en las filas leídas de Google Sheets.\n// La identidad la decide el flujo, no el modelo: si el número no está, el agente no recibe datos.\nconst tel = String($('Normalizar mensaje').first().json.telefono || '').replace(/\\D/g, '');\nconst filas = $input.all().map(i => i.json);\nconst p = tel ? filas.find(r => String(r.telefono ?? '').replace(/\\D/g, '') === tel) : null;\n\nconst campos = ['cliente', 'servicio', 'etapa', 'avance', 'pendiente_cliente', 'proximo_paso', 'fecha_estimada', 'project_manager'];\nconst proyecto = p ? campos.map(c => `${c}: ${p[c] ?? 'sin dato'}`).join('\\n') : '';\n\nreturn [{\n  json: {\n    ...$('Normalizar mensaje').first().json,\n    cliente_identificado: !!p,\n    cliente: p ? p.cliente : 'No identificado',\n    sitio: p ? (p.sitio || '') : '',\n    project_manager: p ? (p.project_manager || 'tu project manager') : '',\n    proyecto,\n  },\n}];"
      },
