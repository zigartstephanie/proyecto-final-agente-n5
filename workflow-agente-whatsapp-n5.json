      "id": "f0000012-0000-4000-8000-000000000012",
      "name": "verificar_sitio",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        1700,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Valida la salida del agente ANTES de responder al cliente y de escribir en la bitácora.\nconst base = $('Code - Buscar proyecto').first().json;\nconst out = $input.first().json;\nconst pasos = out.intermediateSteps || [];\nconst herramientas = pasos.map(p => p.action?.tool).filter(Boolean);\nconst usoRegistro = herramientas.some(t => /registrar/i.test(t));\n\nlet respuesta = String(out.output || '').replace(/\\[DERIVAR\\]/gi, '').trim();\nconst motivos = [];\n\n// 1) El agente registró un pedido → el PM tiene que intervenir\nif (usoRegistro) motivos.push('Pedido registrado por el agente');\n\n// 2) Regla de respaldo: no depende de que el modelo haya usado la herramienta\nconst msg = String(base.texto || '');\nif (/(cambi|factur|pago|precio|presupuest|reclam|queja|urgent|ca[ií]d|no carga|no anda|no funciona)/i.test(msg)\n    && !motivos.length) motivos.push('Regla de palabras clave (el agente no registró el pedido)');\n\n// 3) El cliente nunca ve nombres de herramientas ni texto interno del agente\nif (/(registrar_pedido|verificar_sitio|herramienta|categor[ií]a\\s*\\\\?\")/i.test(respuesta)) {\n  respuesta = `¡Gracias por avisarnos! Ya le pasé tu mensaje a ${base.project_manager || 'tu project manager'}, que te va a escribir a la brevedad.`;\n  motivos.push('Respuesta con texto interno reemplazada');\n}\n\n// 4) Respuesta vacía → mensaje de contingencia\nif (!respuesta || respuesta.length < 5) {\n  respuesta = 'Gracias por escribirnos. Le paso tu consulta a tu project manager, que te va a responder a la brevedad.';\n  motivos.push('Respuesta vacía del agente');\n}\nif (respuesta.length > 600) respuesta = respuesta.slice(0, 597) + '...';\n\n// 5) Si hay que derivar y el agente NO llamó a registrar_pedido, el flujo registra el pedido igual\nconst registro_respaldo = motivos.length > 0 && !usoRegistro;\nconst categoria_sugerida =\n  /(ca[ií]d|no carga|no anda|no funciona|urgent)/i.test(msg) ? 'urgencia' :\n  /(factur|pago|precio|presupuest)/i.test(msg) ? 'facturacion' :\n  /(reclam|queja)/i.test(msg) ? 'reclamo' : 'cambio';\nif (registro_respaldo) motivos.push('Pedido registrado por el flujo (respaldo)');\n\nreturn [{\n  json: {\n    fecha: $now.setZone('America/Argentina/Buenos_Aires').toFormat('yyyy-MM-dd HH:mm'),\n    telefono: base.telefono,\n    cliente: base.cliente,\n    mensaje: base.texto,\n    respuesta,\n    derivar_a_humano: motivos.length > 0,\n    motivo: motivos.join(' | ') || 'Consulta resuelta por el agente',\n    herramientas_usadas: herramientas.join(', ') || 'ninguna',\n    registro_respaldo,\n    categoria: registro_respaldo ? categoria_sugerida : '',\n  },\n}];"
      },
